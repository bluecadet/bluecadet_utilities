<?php

/**
 * @file
 * Module File.
 */

use Bluecadet\DrupalPackageManager\Checker;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\file\FileInterface;
use Drupal\update\UpdateManagerInterface;

const BCU_IMG_GEN_STATE = 'bluecadet_utilities.image_style_gen';

/**
 * Implements hook_theme().
 */
function bluecadet_utilities_theme($existing, $type, $theme, $path) {
  return [
    'svg_image' => [
      'variables' => ['path' => NULL, 'attributes' => []],
    ],
    'input__simple_format_textfield' => [
      'base hook' => 'input',
    ],
  ];
}

/**
 * Implements template_preprocess_hook().
 */
function template_preprocess_svg_image(&$vars) {
  $file_system = \Drupal::service("file_system");
  if (is_file($vars['path']) || is_file($file_system->realpath($vars['path']))) {
    $stream_wrapper_manager = \Drupal::service('stream_wrapper_manager');
    $scheme = $stream_wrapper_manager->getScheme($vars['path']);

    if (!$scheme) {
      $file_str = file_get_contents($file_system->realpath($vars['path']));
    }
    else {
      $file_str = file_get_contents($vars['path']);
    }

    $pattern = "/<\?xml(.*)\?>/s";
    $vars['svg'] = preg_replace($pattern, '', $file_str, 1, $count);
  }
}

/**
 * Implements template_preprocess_hook().
 */
function template_preprocess_input__simple_format_textfield(&$vars) {
  $vars['buttons'] = $vars['element']['#buttons_render'];

  $vars['editable_attributes'] = [
    'contentEditable' => TRUE,
    'class' => ['content-editable'],
  ];

  if (isset($vars['attributes']['required']) && $vars['attributes']['required'] == "required") {
    $vars['attributes']['data-required'] = "required";
  }
}

/**
 * Implements hook_file_validate().
 */
function bluecadet_utilities_file_validate(FileInterface $file) {
  $config = \Drupal::config('bluecadet_utilities.settings');

  if ($config->get('use_transliteration') && isset($file->destination)) {
    $file_system = \Drupal::service("file_system");
    $basename = $file_system->basename($file->destination);
    $basename = bluecadet_utilities_transliterate_filenames_transliteration($basename);
    $dirname = $file_system->dirname($file->destination);
    $file->destination = $file_system->createFilename($basename, $dirname);
  }
}

/**
 * Implements callback for hook_file_validate().
 */
function bluecadet_utilities_transliterate_filenames_transliteration($filename) {
  $filename = \Drupal::service('bluecadet_utilities.sanitize_name')->sanitizeFilename($filename);

  // For empty.
  $name = explode('.', $filename);
  $name = reset($name);
  $extension = explode(".", $filename);
  $extension = end($extension);

  // Is empty.
  if (!$name) {
    $filename = md5(rand(0, getrandmax())) . '.' . $extension;
  }

  return $filename;
}

/**
 * Implements hook_editor_info_alter().
 */
function bluecadet_utilities_editor_info_alter(array &$editors) {
  $config = \Drupal::config('bluecadet_utilities.settings');

  if ($config->get('use_textfield_wysiwyg') && isset($editors['ckeditor'])) {
    $editors['ckeditor']['supported_element_types'][] = 'textfield';
  }
}

/**
 * Implements hook_form_alter().
 */
function bluecadet_utilities_form_alter(&$form, FormStateInterface $form_state) {
  if (in_array($form['#form_id'], [
    "bcu_img_style_generator",
    "bcu_image_style_generator_settings",
  ])) {
    $form['#attached']['library'][] = 'bluecadet_utilities/img-gen';
  }
}

/**
 * Implements hook_field_widget_form_alter().
 */
function bluecadet_utilities_field_widget_form_alter(&$element, FormStateInterface $form_state, $context) {
  $config = \Drupal::config('bluecadet_utilities.settings');

  if ($config->get('use_textfield_wysiwyg')) {
    if (isset($element['#type']) && $element['#type'] == 'text_format' && $element['#base_type'] == 'textfield') {
      $element['#attached']['library'][] = 'bluecadet_utilities/text-editor';
      $element['#attributes']['class'][] = 'text-format-editor';
    }
  }
}

/**
 * Implements hook_form_node_type_form_alter().
 */
function bluecadet_utilities_form_node_type_form_alter(&$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  /** @var \Drupal\node\NodeTypeInterface $type */
  $type = $form_object->getEntity();
  $fields = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $type->id() ?: 'page');

  // Set the weight of the title label field to -10 to ensure it appears above other fields.
  if (isset($form['submission']['title_label'])) {
    $form['submission']['title_label']['#weight'] = -10;
  }

  // Add a text field to the node type form to allow customizing the
  // title field's description (the help text below the field).
  $form['submission']['title_description'] = [
    '#type' => 'textfield',
    '#title' => t('Title field description'),
    '#description' => t('Help text displayed below the title field on the content edit form.'),
    '#default_value' => isset($fields['title']) ? $fields['title']->getDescription() : '',
    '#weight' => -5,
  ];

  $form['actions']['submit']['#submit'][] = 'bluecadet_utilities_node_type_form_submit';
}

/**
 * Submit handler for the node type form to save the title field description.
 */
function bluecadet_utilities_node_type_form_submit(array $form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $type = $form_object->getEntity();
  $fields = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $type->id());

  if (isset($fields['title'])) {
    $description = $form_state->getValue('title_description');
    if ($fields['title']->getDescription() !== $description) {
      $fields['title']->getConfig($type->id())->setDescription($description)->save();
    }
  }
}

/**
 * Implements hook_field_widget_third_party_settings_form().
 *
 * Adds "Field Label" and "Description" settings to the Title field widget
 * on the Form Display configuration page, allowing admins to customize
 * the label and description shown on node edit forms.
 */
function bluecadet_utilities_field_widget_third_party_settings_form($plugin, $field_definition, $form_mode, $form, $form_state) {
  $elements = [];

  if ($field_definition->getName() === 'title') {
    $elements['title_label'] = [
      '#type' => 'textfield',
      '#title' => t('Field Label'),
      '#description' => t('Override the label shown for the Title field on the content edit form. Leave blank to use the default label.'),
      '#default_value' => $plugin->getThirdPartySetting('bluecadet_utilities', 'title_label', ''),
    ];

    $elements['title_description'] = [
      '#type' => 'textfield',
      '#title' => t('Description'),
      '#description' => t('Override the description (help text) shown for the Title field on the content edit form. Leave blank to use the default description.'),
      '#default_value' => $plugin->getThirdPartySetting('bluecadet_utilities', 'title_description', ''),
    ];
  }

  return $elements;
}

/**
 * Implements hook_field_widget_settings_summary_alter().
 *
 * Appends the custom title label and description to the widget summary on the
 * Form Display page.
 */
function bluecadet_utilities_field_widget_settings_summary_alter(&$summary, $context) {
  $field_definition = $context['field_definition'];
  $widget = $context['widget'];

  if ($field_definition->getName() === 'title') {
    $title_label = $widget->getThirdPartySetting('bluecadet_utilities', 'title_label', '');
    if (!empty($title_label)) {
      $summary[] = t('Field Label: @label', ['@label' => $title_label]);
    }

    $title_description = $widget->getThirdPartySetting('bluecadet_utilities', 'title_description', '');
    if (!empty($title_description)) {
      $summary[] = t('Description: @description', ['@description' => $title_description]);
    }
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Applies the custom title field label and description to the node edit form
 * when third-party widget settings have been configured.
 */
function bluecadet_utilities_field_widget_complete_form_alter(&$field_widget_complete_form, FormStateInterface $form_state, $context) {
  $field_definition = $context['items']->getFieldDefinition();

  if ($field_definition->getName() !== 'title') {
    return;
  }

  $widget = $context['widget'];
  $title_label = $widget->getThirdPartySetting('bluecadet_utilities', 'title_label', '');
  $title_description = $widget->getThirdPartySetting('bluecadet_utilities', 'title_description', '');

  if (!empty($title_label) && isset($field_widget_complete_form['widget'][0]['value'])) {
    $field_widget_complete_form['widget'][0]['value']['#title'] = $title_label;
  }

  if (!empty($title_description) && isset($field_widget_complete_form['widget'][0]['value'])) {
    $field_widget_complete_form['widget'][0]['value']['#description'] = $title_description;
  }
}

/**
 * Implements hook_update_status_alter().
 */
function bluecadet_utilities_update_status_alter(&$projects) {
  $modules['bluecadet'] = [
    'bluecadet_utilities',
    'bluecadet_file_struct',
  ];

  $filtered_projects = [];

  foreach ($modules as $user => $user_data) {
    $filtered_projects += array_filter($projects, function($v) use ($user_data) {
        return in_array($v, $user_data);
    }, ARRAY_FILTER_USE_KEY);
  }

  $checker = new Checker($modules, $filtered_projects);

  foreach ($modules as $user => $user_data) {
    foreach ($user_data as $module_name) {
      if (in_array($module_name, array_keys($projects))) {
        $projects[$module_name] = $checker->updateDrupalModulePackage($projects[$module_name], $user, $module_name);
      }
    }
  }
}
