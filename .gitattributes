# exclude .gitignore and similar from the generated tarball
.git*                   export-ignore
.vscode

# exclude CI configurations (useless outside the repo)
.eslintrc               export-ignore
.nvmrc                  export-ignore
assets/src/*            export-ignore
bin                     export-ignore
bin/*                   export-ignore
bldrConfig.js           export-ignore
DEV_README.md           export-ignore
node_modules/*          export-ignore
package-lock.json       export-ignore
package.json            export-ignore
phpunit.xml             export-ignore
postcss.config.js       export-ignore

# these composer.json stubs exist only so the CI coverage-summary action
# breaks out each submodule as its own package row; the submodules aren't
# standalone-installable Composer packages, so exclude them from the tarball
modules/bc_display_title/composer.json  export-ignore
modules/bc_sandbox/composer.json        export-ignore
